    {
      "commit": "fad52ec1259a9365e128ca65ab2e985e37ce8e19",
      "title": "Terminal: release createSubprocess's JNI local references, and the cwd chars against cwd",
      "summary": "createSubprocess took one local reference per argv and envp element and never released it, so they all stayed until the call returned. ART aborts at 512 (local reference table overflow (max=512)) and both loops share the table, so a long argument list plus a large environment could reach it. Fixes #507.",
      "publishedAt": 1791657401000
    },
    {
      "commit": "1b7cb4179dcb3edd0b2e9e86403f0b40270c145e",
      "title": "Windows components: leave out WebView2, which only Microsoft's installer can lay out",
      "summary": "WebView2's files sit in a container no extractor opens (the 145 MB standalone installer's payload is an LZMA resource holding Microsoft's own pack of 2,318 files with no readable directory) and may not be hosted, so a recording cannot source them. Installing it means running Microsoft's installer inside the prefix, which no runtime here does yet. The entry joins the list the page leaves out; with",
      "publishedAt": 1791655816000
    },
    {
      "commit": "c1c22dfd37bd679b3110b21fd2d646b30c465871",
      "title": "Launch the executable a Store package declares",
      "summary": "Store and GDK folders name their game in MicrosoftGame.config or appxmanifest.xml. Picking the top-level Unreal bootstrap instead failed with \"CreateProcess() returned 2\" when the Store had renamed the shipping exe.",
      "publishedAt": 1791654815000
    },

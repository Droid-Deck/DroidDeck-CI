    {
      "commit": "7c08cb58ae5dca6c3bd2a5c1757e4ba5978df61c",
      "title": "Share font defaults across runtime sessions",
      "summary": "Run fontconfig setup before Steam, gamescope, and the desktop in every Linux runtime session. The shared helper links the runtime's default rules and writes DroidDeck's DejaVu aliases to an owned 65-droiddeck-default-fonts.conf; the existing Android font directory bind and language-specific CJK/Thai fallback rules remain in place.",
      "publishedAt": 1791432826000
    },
    {
      "commit": "343a516e1a84933897989ff88913d5d739a31204",
      "title": "Update Russian translation",
      "summary": "Adds 99 Russian translations for strings still present in the current English resources and improves existing Russian copy. Incorporates current-main behavior for automatic storage selection and second-library imports, and clarifies frame-limit and Steam native-suspend descriptions.",
      "publishedAt": 1791432818000
    },

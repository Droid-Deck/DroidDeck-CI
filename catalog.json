    {
      "commit": "f819988b0d9f6f891d594202ff41dab5cd0d3a74",
      "title": "fix: the front end keeps its page when the Fold is folded or unfolded",
      "summary": "Folding or unfolding a foldable no longer restarts the main screen, file manager, file picker and store login, so they keep their state. MainActivity and three more activities now declare orientation|screenSize|screenLayout|smallestScreenSize|density in configChanges, like SessionActivity already does. uiMode is left out on purpose.",
      "publishedAt": 1792035586000
    },
    {
      "commit": "39c8a0fe8c85e048a8f88205344f65b5264000c0",
      "title": "fix: Steam can restart more than twice in a session",
      "summary": "The third time the Steam client restarts in one session, the session ends and DroidDeck is back at the launcher with no error. It does not matter how far apart the restarts are or what asked for them, for example Steam's restart after a language change. This is what is left of #250 on main: a single language change now restarts fine (checked on a build of 3820445).",
      "publishedAt": 1792031483000
    },
    {
      "commit": "44331558cc96693870eab5885596aa4d1def89c3",
      "title": "feat: droiddeckctl reports on-screen pacing (recover #843)",
      "summary": "Adds droiddeckctl pacing [--seconds N]. It reports what actually reached the panel during a capture, which a game's own fps counter can't show. The numbers in #634 (fixed by #717) came from this same source. There, a game whose counter read a steady 60 was putting about 57 frames a second on screen, and a quarter of the intervals were off-cadence.",
      "publishedAt": 1792031168000
    },
    {
      "commit": "d2bab8970d91fd7731958626e2b7f1280d33dd2d",
      "title": "fix: droiddeckctl reaches variant-package builds (recover #842)",
      "summary": "droiddeckctl couldn't talk to the builds shipped under another package (tools/release/variants.txt: pubg, antutu, ludashi). The provider authority and the start Activity's component were fixed to com.droiddeck.launcher. Every command failed with an unknown provider, or failed to start the Activity, on a phone that only has a variant installed. That's common on devices whose game mode keys on",
      "publishedAt": 1792031042000
    },
    {
      "commit": "38d560cef1e2a042641a4559bd799617fac83e17",
      "title": "fix: an interrupted Linux runtime download resumes instead of starting again",
      "summary": "Fixes #811. An interrupted Linux runtime download now resumes from the bytes it kept instead of starting again. The installer used to delete the archive in its finally block after any outcome, so a retry always began at zero even though the downloader supports Range requests.",
      "publishedAt": 1792030236000
    },
    {

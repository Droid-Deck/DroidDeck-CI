    {
      "commit": "6e0d456dd7d250e8ac56798fba8db2e4057da275",
      "title": "fix(amazon): sync library with nile's headers and registered serial",
      "summary": "Signed-in Amazon accounts showed no games. The entitlements call now matches nile, the reference client that works:",
      "publishedAt": 1791644764000
    },
    {
      "commit": "8ac555664ad1b079019d00af3348125d0de0c7c1",
      "title": "Windows components: Access 2000 runtime installs here (an MSI inside a 7-Zip-openable wrapper)",
      "summary": "The recorder hung twice on art2kmin.exe because it is not a setup program at all: a wrapper 7-Zip opens, holding Setup.exe + Data1.msi. The MSI engine already lays such wrappers out (--unpack \u2192 packages inside), so the entry only had to leave the setup-program list. The catalog is untouched.",
      "publishedAt": 1791610634000
    },
    {
      "commit": "4bf4e53ecf0b6b79be977db8a0a159976637b5e1",
      "title": "Build: verify the runtime inputs only after the session scripts are staged",
      "summary": "Main's build at 3d50e6b1 failed with Missing or changed runtime input: assets/linuxfs/usr/local/bin/droiddeck-netmanager. org.gradle.parallel is on and nothing ordered verifyRuntimeInputs after stageSessionScripts, which re-copies the session scripts into the asset tree, so the check hashed a file mid-copy. The log shows the two tasks within a tenth of a second of each other. First time",
      "publishedAt": 1791607591000
    },
    {
      "commit": "846b20f78aa9e5a037c8fd4a989777ff097e90f5",
      "title": "CI: re-pin the Debian image and stop the publish workflow replacing it",
      "summary": "Main's first build after #497 failed the hosted image's checksum and fell back to the registry pull (it passed, through the fallback). Cause: the publish workflow still had a push trigger on its branch, which fired again on the rebase before the merge and overwrote debian-bullseye.tar.zst with a freshly compressed copy, whose checksum differs from the pinned one.",
      "publishedAt": 1791605308000
    },
    {
      "commit": "a229d196bbad8f9abf85ec1c1ff94e937e6b1564",
      "title": "CI: host the Debian image the preloads build in on a release of this repo",
      "summary": "The x86 preloads step pulled debian:bullseye from a public registry mirror on every build whose preload cache missed. Those mirrors rate-limit GitHub's shared runner addresses, and the pull failed two builds in one hour tonight (toomanyrequests: Rate exceeded). Debian 11 is frozen upstream (archive.debian.org), so there is nothing to track: the image is a one-time snapshot.",
      "publishedAt": 1791602971000
    },
    {
      "commit": "9b90386e73b83ac5b43a64831b150c7852c18e38",
      "title": "Windows components: install from a recording of the installer's result",
      "summary": "A catalog entry may now carry a snapshot link: a recording of what the component's own setup program leaves in a prefix, made once in Wine by winlator-contents' tools/snapshot/record.py (The412Banner/winlator-contents PR, which must land first since the app reads the catalog from main). With one, the setup program never runs here.",
      "publishedAt": 1791601480000
    },
    {
      "commit": "ddc4c18faf1f4bc7b742a817e597db51ba9947bf",
      "title": "Steam's touch controller as on-screen controls (beta)",
      "summary": "Adds Touch controls: Steam (beta) to the session drawer. In a Steam session it replaces DroidDeck's on-screen pad with Steam's own touch controller, the one the Steam Link apps use. Bindings, action sets, per-game touch configs, Valve's templates, official and community configs and Steam Cloud sync are all Steam's. DroidDeck draws the controls and feeds the controller's input. Off by default.",
      "publishedAt": 1791599520000
    }
  ],

    {
      "commit": "b213ae77b4d274ceeb12230c4696b37b6cb106e5",
      "title": "feat(stores): bring the launcher's motion to the stores pages",
      "summary": "Brings the Stores section in line with the motion the rest of the launcher already has. No new primitives: it's the Play flood, PageFlood, the focus ring's glide and End session's step-out, applied to the store pages.",
      "publishedAt": 1791572439000
    },
    {
      "commit": "6e5932cb682ebdec4c36ae253e839c52ab2376e7",
      "title": "Stores: seal the GOG, Epic and Amazon sign-in files with an Android Keystore key",
      "summary": "The stores' sign-ins (files/stores/<store>/credentials.json: access and refresh tokens, account id and name) were plain JSON. Other Android apps could not read them, but every program in the Linux session (games, mods, Flatpak apps) runs as the app uid and could. This seals them with AES-256-GCM under a non-exportable AndroidKeyStore key (StrongBox when available), so the session only ever sees",
      "publishedAt": 1791571788000
    },
    {
      "commit": "38e3fa2a33299a6b67127c34354c77981a610886",
      "title": "Logs: every log in app-private storage, shared as one scrubbed zip",
      "summary": "Moves every DroidDeck log out of the public Download/DroidDeck folder into the app's private files/logs. Every existing \"Share logs\" action now bundles them into one zip that goes through a final scrub. One squashed commit over current main.",
      "publishedAt": 1791567318000
    },
    {
      "commit": "8e1a676f1957d1fbd3e3491e74b6e77269821aab",
      "title": "Windows components: lay out installer .exe wrappers without running them",
      "summary": "The components page could only take .msi packages apart, so most catalog entries that ship an installer .exe sat under \"Need a Windows installer\": every VC++ runtime, .NET Framework 4.0 to 4.8, the .NET Core/5+ desktop runtimes. This teaches droiddeck-msi-install to open those wrappers and lay out the packages inside exactly as it does today for an .msi: files into the component folder, re",
      "publishedAt": 1791564248000
    },
    {
      "commit": "7c946db440aa3396dba8039f59a30388b2034d8f",
      "title": "Stores: GOG, Epic Games and Amazon Games \u2014 libraries, installs, cloud saves",
      "summary": "A Stores section in the rail, under Games. It's gated by Setup \u203a Stores \u203a \"Show Stores in the rail\" and is off by default. It has sign-in, library and storefront for GOG, Epic Games and Amazon Games, plus one download queue. Installed games are registered in the Steam client as non-Steam games, so they launch through Steam and droiddeck-proton. Overlay, Steam Input and Remote Play Together w",
      "publishedAt": 1791559013000
    },
    {

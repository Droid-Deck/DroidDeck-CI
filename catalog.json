  "recentPreviews": [
    {
      "commit": "db2e1d7da2fd6bdaf526c720357abc0d22259909",
      "title": "Fix runtime removal and first-run Steam setup",
      "summary": "Prevent Play from racing runtime removal, show progress beneath the runtime row, install Steam from the selected channel, refresh and verify required helpers, and initialize UI scaling once while preserving user choices; covered by regression tests and Thor QA.",
      "publishedAt": 1791079684000
    },
    {
      "commit": "f5e204eb1d39d1e2732c75a9bc6b0c030b990f8b",
      "title": "Add game file exports and sync for Android frontends",
      "summary": "Adds per-game launch files, Steam game icons, and optional library folder sync for Android frontends, validated on wireless Thor with Cocoon icons and cold/warm launches, safe sync and rejection checks, and 131 passing release tests.",
      "publishedAt": 1791077659000
    },
    {
      "commit": "705a5e7b2a4c742f3d91e7c55533fb58cf12538a",
      "title": "Give protonfixes a readable /proc/sys/fs/file-max",
      "summary": "GE-Proton and proton-cachyos run protonfixes before every game, and it opens /proc/sys/fs/file-max, which Android denies to apps. The PermissionError aborts the launch, so no game starts with those tools. The session now binds a stand-in with the 64-bit kernel default, the same way it already does for the other /proc files Android hides.",
      "publishedAt": 1791055882000
    },
    {
      "commit": "e60eae36460dead7d9db948e9fe00523515413bd",
      "title": "Add standard session picture in picture",
      "summary": "Adds manual and optional automatic PiP with standard Android controls and Thor second-screen restoration, with no mute or custom suspend actions; the signed release build, 121 unit tests, and Steam/desktop PiP checks passed on Thor.",
      "publishedAt": 1791054783000
    },
    {
      "commit": "b04900b1b27bd2c3f1dc50f5dc0d973ef13454a8",
      "title": "Fix black screen after resuming Steam sessions",
      "summary": "\u2022 prevent the Steam login1 suspend callback from blocking during a synchronous D-Bus flush\n\u2022 publish the host sleep request only after the suspend signal and method reply have been transmitted asynchronously\n\u2022 recover the handshake if the asynchronous flush fails\n\u2022 cover suspend after the login1 service has been frozen and resumed",
      "publishedAt": 1791052439000
    },
    {
      "commit": "67fb338e5d4e04ff30bb78b47d534c39ad5a801a",
      "title": "Show Preview update history",
      "summary": "The Preview status card shows recent published changes below the update action and counts builds behind only when the installed CI Preview commit can be matched unambiguously, verified with a release build and simulated-history screenshots on Thor.",
      "publishedAt": 1791049260000
    },
    {
      "commit": "f3600fa618d8d0174ca35fbf41710df2c946fb1e",
      "title": "Add game launcher shortcuts",
      "summary": "Adds canonical game launch links, Android home shortcuts, and ACTIONCREATESHORTCUT support for installed and added games.",
      "publishedAt": 1791043766000
    },
    {
      "commit": "255c64551ec7d5a810da622d918eb88ffdccb231",
      "title": "Expose the compositor's upscaler (FSR 1 / GSR / NIS) as a session setting",
      "summary": "The compositor already ships the spatial upscalers from the X11 renderer: effectschain.c has FSR 1 (EASU+RCAS), Snapdragon GSR and its quality variant, NIS, and RCAS sharpen, plus a sharpness slider. They're reachable through WaylandCompositor.nativeSetUpscaler / nativeSetUpscaleSharpness, but nothing has called them since the Winlator-era drawer was removed. So the scene is always enlarged",
      "publishedAt": 1790998449000
    },
    {
      "commit": "2b481ba2501b3eb727592ae3308441463bdd03e3",
      "title": "Fix Steam idle sleep and Android session wake",
      "summary": "Restore Steam\u2019s main screen after idle sleep by bridging login1 sleep/wake notifications to Android session pause/resume, verified on Thor with the one-minute timer, Android lifecycle transitions, all three suspend policies, four D-Bus recovery tests, and a signed release build.",
      "publishedAt": 1790992127000
    },
    {
      "commit": "69f99ade42695f7fb5fababd4bc758d222085988",
      "title": "Fix Deck controller discovery on older handheld kernels",
      "summary": "Recover missing statx mount IDs from fdinfo for Steam's Deck controller discovery on older kernels, scoped to libudev/libsystemd with inode verification and a one-time log; the reduced fix passed a signed local build, Thor handshake, and compatibility, error, and descriptor checks.",
      "publishedAt": 1790991572000
    }
  ],

    },
    {
      "commit": "255c64551ec7d5a810da622d918eb88ffdccb231",
      "title": "Expose the compositor's upscaler (FSR 1 / GSR / NIS) as a session setting",
      "summary": "The compositor already ships the spatial upscalers from the X11 renderer: effectschain.c has FSR 1 (EASU+RCAS), Snapdragon GSR and its quality variant, NIS, and RCAS sharpen, plus a sharpness slider. They're reachable through WaylandCompositor.nativeSetUpscaler / nativeSetUpscaleSharpness, but nothing has called them since the Winlator-era drawer was removed. So the scene is always enlarged",
      "publishedAt": 1790998449000
    },
    {
      "commit": "2b481ba2501b3eb727592ae3308441463bdd03e3",
      "title": "Fix Steam idle sleep and Android session wake",
      "summary": "Restore Steam\u2019s main screen after idle sleep by bridging login1 sleep/wake notifications to Android session pause/resume, verified on Thor with the one-minute timer, Android lifecycle transitions, all three suspend policies, four D-Bus recovery tests, and a signed release build.",
      "publishedAt": 1790992127000
    },
    {
      "commit": "69f99ade42695f7fb5fababd4bc758d222085988",
      "title": "Fix Deck controller discovery on older handheld kernels",
      "summary": "Recover missing statx mount IDs from fdinfo for Steam's Deck controller discovery on older kernels, scoped to libudev/libsystemd with inode verification and a one-time log; the reduced fix passed a signed local build, Thor handshake, and compatibility, error, and descriptor checks.",
      "publishedAt": 1790991572000
    },
    {
      "commit": "7b20b70c6bb55163be0bfc255e981b7a322bc2c9",
      "title": "Add Android clipboard text paste into Steam sessions",
      "summary": "Adds Android clipboard text paste into DroidDeck Steam sessions, verified on Thor by typing and copying in a native Android editor and pasting into Steam; screenshots and validation are in docs/testing/android-clipboard.md.",
      "publishedAt": 1790978026000
    },
    {
      "commit": "3404bbc128f3d206bed8afbd0f7259c5ddf4c5c0",
      "title": "Show Android Wi-Fi and cellular networks in Steam BPM",
      "summary": "Expose Android Wi-Fi and cellular connections to Steam BPM, including Wi-Fi names and nearby networks when Location access is available, with generic Wi-Fi status as the fallback.",
      "publishedAt": 1790972605000
    },

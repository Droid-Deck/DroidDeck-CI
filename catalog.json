    {
      "commit": "78fcb60fd5e6eb394bd587fe8ea7a515bed4c10b",
      "title": "DroidDeck-Proton as a Proton source, and update checks for every source",
      "summary": "What\n\u2022 Setup \u203a Proton versions: DroidDeck-Proton (The412Banner/DroidDeck-Proton) added as a third source beside GE-Proton and proton-cachyos. It uses the GE-style aarch64 tarball and sha512 file, and is also accepted as droiddeck by droiddeck-proton-extra / the session queue. steam-compatibility adopts it like any other extra, so Steam lists it as \"DroidDeck-Proton 11-7.5 (Compatible)\".\n\u2022 Update c",
      "publishedAt": 1791749775000
    },
    {
      "commit": "3c2878cc522a917af17581d60de33c591b002738",
      "title": "Red Dead Redemption 2: launches again, no screensaver over games, hidden launcher held to one core, /tmp cleaned",
      "summary": "Red Dead Redemption 2 exited with 0xc0000135 right after the Rockstar launcher started it. With that fixed, playing it showed three more problems: Steam's screensaver covered the game, Rockstar's hidden launcher took cores from it, and every session left files in the guest's /tmp.",
      "publishedAt": 1791748898000
    },
    {
      "commit": "dde08414fcc02eb829220ad5777015ead683c0df",
      "title": "feat: big ass redesign: Carry the stores' motion and layout into Steam settings, Components, Setup, Flathub and Desktop",
      "summary": "Takes the motion vocabulary from the stores work and applies it, with a layout pass, to the parts of the app still on older patterns. One commit per phase, in order.",
      "publishedAt": 1791745987000
    },
    {
      "commit": "ec24b3a47224c7669fa2d83c9a590a0176cfcba9",
      "title": "feat: the built-in pad can be a DualShock 4 or DualSense, its touchpad fed by the trackpads",
      "summary": "Adds DualShock 4 and DualSense to the built-in pad's controller types, in Mode settings and in the session menu's live switch. Builds on #558 (live switching, merged).",
      "publishedAt": 1791693000000
    },
    {
      "commit": "6455b1dade2c2ef7d0e593da5946181de737022f",
      "title": "feat: the built-in pad's controller type switches from the session menu while Steam runs",
      "summary": "The session menu's Controller page gets a Controller row: Steam Deck controller, Steam Controller or Xbox 360 controller. The choice switches what the built-in pad is to Steam immediately, with no new session. It is also saved as the default for the next session, so it stays in sync with the setting in Mode settings.",
      "publishedAt": 1791692403000
    },

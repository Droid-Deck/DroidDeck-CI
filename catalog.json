      "title": "Empty library intro",
      "summary": "",
      "publishedAt": 1791081155000
    },
    {
      "commit": "db2e1d7da2fd6bdaf526c720357abc0d22259909",
      "title": "Fix runtime removal and first-run Steam setup",
      "summary": "Prevent Play from racing runtime removal, show progress beneath the runtime row, install Steam from the selected channel, refresh and verify required helpers, and initialize UI scaling once while preserving user choices; covered by regression tests and Thor QA.",
      "publishedAt": 1791079684000
    },
    {
      "commit": "f5e204eb1d39d1e2732c75a9bc6b0c030b990f8b",
      "title": "Add game file exports and sync for Android frontends",
      "summary": "Adds per-game launch files, Steam game icons, and optional library folder sync for Android frontends, validated on wireless Thor with Cocoon icons and cold/warm launches, safe sync and rejection checks, and 131 passing release tests.",
      "publishedAt": 1791077659000
    },
    {
      "commit": "705a5e7b2a4c742f3d91e7c55533fb58cf12538a",
      "title": "Give protonfixes a readable /proc/sys/fs/file-max",
      "summary": "GE-Proton and proton-cachyos run protonfixes before every game, and it opens /proc/sys/fs/file-max, which Android denies to apps. The PermissionError aborts the launch, so no game starts with those tools. The session now binds a stand-in with the 64-bit kernel default, the same way it already does for the other /proc files Android hides.",
      "publishedAt": 1791055882000
    },
    {
      "commit": "e60eae36460dead7d9db948e9fe00523515413bd",
      "title": "Add standard session picture in picture",
      "summary": "Adds manual and optional automatic PiP with standard Android controls and Thor second-screen restoration, with no mute or custom suspend actions; the signed release build, 121 unit tests, and Steam/desktop PiP checks passed on Thor.",
      "publishedAt": 1791054783000
    }

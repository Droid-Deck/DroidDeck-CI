    {
      "commit": "666abd134fca6ce8487cd8432c432843c552e8b4",
      "title": "Windows components: a recommended component is listed once, not again under All",
      "summary": "The full list left out only the 'installed for this game' rows, never the recommendations, so every recommended component appeared twice: once under Recommended and again under All, both toggles mirroring each other (DirectX 9 on Final Fantasy Resonance Demo). The full list now leaves the recommended set out as well; its count drops by that many.",
      "publishedAt": 1791659150000
    },
    {
      "commit": "c115916962c839d1d03186e73ee4a3231d56c27a",
      "title": "Read the phone's motion sensors only while Steam asks for them",
      "summary": "On my S23 Ultra (Snapdragon 8 Gen 2), the session's pad-motion thread used 5\u20137% of a core\nduring gameplay, even in games that don't use gyro.",
      "publishedAt": 1791658257000
    },
    {
      "commit": "0579e688baa4304077ea7f80b9d98df4c47895cb",
      "title": "fix: preserve keyboard input on composite devices",
      "summary": "Fixes #422",
      "publishedAt": 1791658179000
    },
    {
      "commit": "bc50de3b5546ad093c8b636288563d2793ca7ef4",
      "title": "Fix CPU temperature showing 0\u00b0C in the performance overlay",
      "summary": "Since #494 the performance overlay showed the CPU temperature as 0\u00b0C on my S23 Ultra (Snapdragon 8 Gen 2).",
      "publishedAt": 1791658066000
    },
    {
      "commit": "648923259809723bae7992eeeaf5c6d15df149b8",
      "title": "Fix NativeAOT GC region range defaults",
      "summary": "Games built with older NativeAOT runtimes can fail at startup because those runtimes reject the 0x prefix in DOTNETGCRegionRange. Using 800000000 keeps the intended 32 GiB limit, and CoreCLR accepts it too.",
      "publishedAt": 1791657952000
    },
    {
      "commit": "c23c43650240e7fd7cd2f21d2ae9c1dab33dba98",
      "title": "Controller: optional Select button that opens the Steam menu",
      "summary": "Adds an off-by-default option in Setup \u2192 Controller that makes the physical Select button open the Steam menu in a session instead of View/Select.",
      "publishedAt": 1791657856000
    },
    {
      "commit": "d22e458d642a4f093eb7a3f44ca242b12959caf8",
      "title": "fix(audio): avoid InputStream.readAllBytes() for Android 12 compatibility",
      "summary": "In PulseAudioComponent.java, pactl() calls InputStream.readAllBytes(). While available in desktop Java 9+, on Android this method was only introduced in API level 33 (Android 13)).\nSince DroidDeck targets minSdkVersion 26, devices on Android 12 or earlier (API 26\u201332, such as the LG V50s ThinQ) crash when starting a session:\nFATAL EXCEPTION: pulse-sink-guard\njava.lang.NoSuchMethodError: No virtual ",
      "publishedAt": 1791657433000
    },
    {
      "commit": "fad52ec1259a9365e128ca65ab2e985e37ce8e19",
      "title": "Terminal: release createSubprocess's JNI local references, and the cwd chars against cwd",
      "summary": "createSubprocess took one local reference per argv and envp element and never released it, so they all stayed until the call returned. ART aborts at 512 (local reference table overflow (max=512)) and both loops share the table, so a long argument list plus a large environment could reach it. Fixes #507.",
      "publishedAt": 1791657401000
    },
    {
      "commit": "1b7cb4179dcb3edd0b2e9e86403f0b40270c145e",
      "title": "Windows components: leave out WebView2, which only Microsoft's installer can lay out",
      "summary": "WebView2's files sit in a container no extractor opens (the 145 MB standalone installer's payload is an LZMA resource holding Microsoft's own pack of 2,318 files with no readable directory) and may not be hosted, so a recording cannot source them. Installing it means running Microsoft's installer inside the prefix, which no runtime here does yet. The entry joins the list the page leaves out; with",
      "publishedAt": 1791655816000
    }
  ],

    {
      "commit": "3278afaa1af7fe9b43420e621752f2e9c27e05ef",
      "title": "Fast path: hold every bind, so added games start in their own folder",
      "summary": "Added games (Games folders) start in C:\\windows instead of their own folder. Every launch logs:",
      "publishedAt": 1791309315000
    },
    {
      "commit": "bf221ffbbd689d63212eff43e67e284557cf52a7",
      "title": "fix: resolution presets keep the panel shape at 720p, 900p and 1080p",
      "summary": "\u2022 Resolution presets are now heights: 720p (default), 900p, 1080p. Each uses the panel's shape, is never narrower than 16:9 and never taller than the panel.\n\u2022 Unchanged: Match screen (exact panel), Custom, and any fixed size already saved.\n\u2022 The device report shows the resolved size next to the choice, e.g. 720p (1608x720).",
      "publishedAt": 1791307552000
    },
    {
      "commit": "c636eea355bf45f9013ee02676b8490e6968dd65",
      "title": "fix: hold flood edges at the page edge once reached",
      "summary": "The blue flood (Play, and the red Stop in the session drawer) sometimes left a sliver of the page showing on the left or right, flickering in and out, before the next screen took over. It didn't happen every time.",
      "publishedAt": 1791303122000
    },
    {
      "commit": "ffaa906cd1bccc1eff1c263ec83d305cdb49f92f",
      "title": "fix: catch KGSL GEMCLOSE at ioctl instead of exporting drmIoctl",
      "summary": "NMS on an Adreno 840 has judder that looks like old frames being replayed. #302 (a straight revert of #275) is smooth; main is not.",
      "publishedAt": 1791302380000
    },
    {
      "commit": "d61af961c1eafe720ed348218f55fdef18e9cf3e",
      "title": "Windows components for Steam and added games; no more redist installer prompts",
      "summary": "\u2022 Added games get a bare Proton prefix (DiRT 3 needed OpenAL32.dll and exited on every Proton).\n\u2022 Steam titles: on first launch the client runs the game's CommonRedist installers in the prefix. On ARM64 Proton the x64 VC++ 2015-2022 bundle stops with \"Microsoft Visual C++ 2015-2022 Redistributable (arm64) is required\" (reported on an AYN Odin 2 Portal Max), others hang under FEX. An Odin 3 bundle ",
      "publishedAt": 1791298595000
    },
    {
      "commit": "bc01b77752de682b344d2ec575f78aafe7fe4a14",
      "title": "Force SSBS for Proton games (libssbs.so), switch under FEX preset",
      "summary": "Wine's arm64 signal code resumes threads from a Windows CONTEXT whose Cpsr never carries PSTATE.SSBS (bit 12), so after a signal return the thread runs with speculative store bypass disabled \u2014 slower on cores such as Oryon (reports of large gains on Snapdragon 8 Elite, e.g. Fallout: New Vegas). Sonicadvance1's forcessbs.diff fixes it inside ntdll; Bannerlator ships it in its own Wine bu",
      "publishedAt": 1791293649000
    },
    {
      "commit": "a1b01a04a83f90c9517ef386698afef48f8eb180",
      "title": "Added support for Adreno 6xx devices",
      "summary": "Adds (experimental) support for Adreno 6xx series. Turnip on those chips does not expose storageBuffer8BitAccess, so Proton's shipped DXVK 3 refuses to start DirectX 11 games.",
      "publishedAt": 1791292439000
    },
    {
      "commit": "b44235c495fa6458aa438c9ba3be06562e5d1a3c",
      "title": "Add Native Steam background sleep and automatic wake",
      "summary": "Add an opt-in Native background behavior for Steam sessions. When the screen turns off or the session is fully hidden, notify Steam of system sleep, allow 1.5 seconds for preparation, then freeze the guest and audio. Returning automatically completes the wake handshake. Visible PiP keeps running; dismissing PiP retains and suspends the session.",
      "publishedAt": 1791260541000
    },
    {
      "commit": "b80d5db176d25f04ee3d45e85f4671b857369dd3",
      "title": "ci: require isolated version bumps",
      "summary": "Require any PR that changes versionCode or versionName to contain only those version lines in app/build.gradle. This keeps PR test builds from consuming the next Android version code alongside unrelated code.",
      "publishedAt": 1791257610000
    },
    {
      "commit": "d3c0d258b714b8d7638c4c52ecd7c7e00972983d",
      "title": "Return frontend-launched sessions to Android Home",
      "summary": "Return intent-launched game sessions to Android\u2019s default Home frontend on exit while preserving DroidDeck\u2019s return behavior for games launched from its Games tab.",
      "publishedAt": 1791251130000
    }
  ],

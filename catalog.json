    {
      "commit": "e7b6876877243ca27dafe0d584f74684573138c8",
      "title": "Add the droiddeck-esync pack pipeline",
      "summary": "Builds esync packs for new Valve, GE and CachyOS Proton 11 releases on arm64 runners, smoke-tests them against stock with esstress, and on main publishes each pack and a signed index as non-latest releases. A watcher checks Steam and the GE/CachyOS releases every 20 minutes and starts a build for new ones. The app side lands separately with feat/userspace-esync-ntsync.",
      "publishedAt": 1791083049000
    },
    {

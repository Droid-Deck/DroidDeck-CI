    {
      "commit": "0607bb0b3a3b1dc08665cbf0618db0993b3988f3",
      "title": "Fix Xwayland dma-buf leak: close Zink's emulated GEM handles on KGSL",
      "summary": "With Force game windows fullscreen on, a game whose own resolution differs from the screen (DiRT 3 at 1280x720) fights gamescope over its window size and recreates its swapchain many times a second. Every old swapchain image stayed alive inside Xwayland: ~2,000 buffers / 6+ GB in about 15 s, then Android's low-memory killer closed the session and background apps. The memory was only returned w",
      "publishedAt": 1791219159000
    },
    {
      "commit": "9f46c7a50b6f583e0040040882a025d4e7813491",
      "title": "Force game windows fullscreen: off by default",
      "summary": "With Force game windows fullscreen on, a game running at a resolution other than the screen's (DiRT 3 defaults to 1280x720) fights gamescope's --force-windows-fullscreen: every forced resize makes it rebuild its swapchain and the picture flickers between its own size and full screen \u2014 696 swapchain rebuilds in a 4-minute DiRT 3 session on the Pocket FIT. Many games start at such a default",
      "publishedAt": 1791218978000
    },
    {
      "commit": "06e06b9673be9b875c4537bbc79c576d397a66d7",
      "title": "Fix MangoHud double-counting battery power and remaining life",
      "summary": "DroidDeck exposed Android's aggregate battery twice, as BAT0 and BAT1. MangoHud discovered both supplies and counted the same battery twice, inflating wattage and estimated remaining lifetime while Steam's QAM estimate stayed accurate. Export only BAT1 and remove the legacy BAT0 directory when each session starts. This applies to every device using the battery bridge without vendor-specific calibr",
      "publishedAt": 1791213210000
    },
    {
      "commit": "b896e7a3b9081a92b43c8b9f4717fb1ac2056966",
      "title": "Compact Steam, Desktop, and Setup settings headers",
      "summary": "Settings headers used multiple rows, reducing the space available for settings on handheld screens. Steam and Desktop now place Back and the LB/RB tab strip on one row without a page title; Desktop groups its settings into Display, Controls, and Session tabs. Setup places its title and tabs on one row and removes the summary status badge.",
      "publishedAt": 1791211205000
    },

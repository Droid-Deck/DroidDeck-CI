    {
      "commit": "7da27d4ff4a5d9b006ae9febcd565b45a9eca617",
      "title": "feat: add build watermark toggle for Lab, test, and local builds",
      "summary": "\u2022 Add a Build label watermark toggle at the bottom of the Updates tab.\n\u2022 Control both test-build and Lab-build watermarks, including the Lab label shown over an installed release build.\n\u2022 Keep the watermark enabled by default. Users can hide or restore it immediately, and their choice persists across restarts.\n\u2022 Include translated setting text for all 32 non-English locale variants, alongside Engl",
      "publishedAt": 1794454694000
    },
    {
      "commit": "02a5be62da4dc1af8f5e18f49dc14c0185126f04",
      "title": "fix(input): a controller that disconnects mid-event no longer closes the app",
      "summary": "DroidDeck can close during a session with NullPointerException in PadBridge.noteDevice when a controller disconnects while one of its key events is being handled. KeyEvent.getDevice() looks the device up again on every call, so the first lookup (to pick the player slot) finds the controller and a later one in the same event returns null.",
      "publishedAt": 1794452962000
    },
    {
      "commit": "956f17239b2ad6ea1a37ee6c0edbda9f8c84d27e",
      "title": "fix(storage): Clean up keeps Proton EasyAntiCheat and BattlEye runtimes",
      "summary": "Clean up listed \\\"Proton EasyAntiCheat Runtime\\\" and \\\"Proton BattlEye Runtime\\\" as unused x86 Protons because their install folders start with \\Proton \\. Steam fetches these runtimes for any game that ships anti-cheat files, even when the launch option skips anti-cheat (e.g. Halo MCC). With the runtime removed, the game's install and launch stall at \\\"Downloading Content 0%\\\": Steam reuses the",
      "publishedAt": 1794449260000
    },
